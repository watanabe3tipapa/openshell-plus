# ---- 実行モード ----
# local / cloudflare / vercel / colab / sandbox（空なら自動判定）
OSUI_MODE=local
OSUI_HOST=127.0.0.1
OSUI_PORT=8080
OSUI_DEBUG=false
OSUI_LOG_LEVEL=info

# ---- 認証 ----
# 空なら認証なし。loopback 以外へ bind する場合は必ず設定すること
OSUI_AUTH_TOKEN=
# CORS 許可オリジン（JSON 配列）
OSUI_CORS_ORIGINS=[]

# ---- バックエンド ----
# true で in-memory demo backend を強制（Vercel / Colab 用）
OSUI_DEMO=false
# true の場合、gateway へ接続できなければ demo へ落ちずに起動を失敗させる
OSUI_REQUIRE_GATEWAY=false
OSUI_WORKSPACE=default
OSUI_PAGE_SIZE=100
# SSE エンドポイントを公開するか（Cloudflare Quick Tunnel では false を推奨）
OSUI_SSE_ENABLED=true

# ---- exec ----
OSUI_EXEC_DEFAULT_TIMEOUT=60
OSUI_EXEC_MAX_TIMEOUT=1800

# ---- OpenShell gateway ----
# 空なら SDK の from_active_cluster() が active cluster を自動検出
OSUI_GATEWAY_ENDPOINT=
OSUI_GATEWAY_TIMEOUT=30
OSUI_GATEWAY_CLUSTER=
# TLS 検証用 CA と mTLS クライアント証明書（CERT と KEY は同時指定が必須）
OSUI_GATEWAY_CA_CERT=
OSUI_GATEWAY_CERT=
OSUI_GATEWAY_KEY=
OSUI_GATEWAY_INSECURE=false

# ---- OIDC クライアント認証 ----
OSUI_OIDC_ISSUER=
OSUI_OIDC_CLIENT_ID=
OSUI_OIDC_CLIENT_SECRET=
OSUI_OIDC_AUDIENCE=
OSUI_OIDC_SCOPES=[]
